{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=127.0.0.1;Port=5433;Database=PaymentDb;Username=db_user;Password=123456;"
  },
  "Momo": {
    "PartnerCode": "MOMO_PARTNER_CODE",
    "AccessKey": "YOUR_MOMO_ACCESS_KEY",
    "SecretKey": "YOUR_MOMO_SECRET_KEY",
    "BaseUrl": "https://test-payment.momo.vn/v2/gateway/api",
    "IpnUrl": "https://your-domain.ngrok-free.dev/api/webhooks/momo",
    "RedirectUrl": "http://localhost:5173/"
  },
  "VNPay": {
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "RedirectUrl": "https://your-domain.ngrok-free.dev/api/checkout/vnpay/callback"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} <{SourceContext}>{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5052",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:5053",
        "Protocols": "Http2"
      }
    }
  },
  "Services": {
    "SellerGrpcUrl": "http://localhost:5043"
  },
  "IdentityUrl": "http://localhost:5027"
}

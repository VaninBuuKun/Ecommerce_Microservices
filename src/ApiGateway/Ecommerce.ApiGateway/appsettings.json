{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "IdentityUrl": "http://localhost:5027"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-api-routes": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "user-api-routes": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "role-api-routes": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "identity-server-routes": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": {
          "Path": "/connect/{**catch-all}"
        }
      },
      "products-routes": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "wishlist-routes": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/wishlists/{**catch-all}"
        }
      },
      "medias-routes": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/medias/{**catch-all}"
        }
      },
      "categories-routes": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "banners-routes": {
        "ClusterId": "product-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/banners/{**catch-all}"
        }
      },
      "cart-routes": {
        "ClusterId": "cart-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/carts/{**catch-all}"
        }
      },
      "orders-routes": {
        "ClusterId": "order-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "voucher-routes": {
        "ClusterId": "order-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/vouchers/{**catch-all}"
        }
      },
      "payments-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "checkout-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/checkout/{**catch-all}"
        }
      },
      "wallet-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/wallet/{**catch-all}"
        }
      },
      "withdrawal-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/withdrawals/{**catch-all}"
        }
      },
      "admin-withdrawal-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/withdrawals/{**catch-all}"
        }
      },
      "admin-wallet-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/admin/wallets/{**catch-all}"
        }
      },
      "refund-routes": {
        "ClusterId": "order-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/refunds/{**catch-all}"
        }
      },
      "momo-webhook-routes": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/webhooks/momo/{**catch-all}"
        }
      },
      "seller-shop-routes": {
        "ClusterId": "seller-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/shop/{**catch-all}"
        }
      },
      "seller-kyc-routes": {
        "ClusterId": "seller-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/kyc/{**catch-all}"
        }
      },
      "shipping-shipments-routes": {
        "ClusterId": "shipping-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/shipments/{**catch-all}"
        }
      },
      "shipping-locations-routes": {
        "ClusterId": "shipping-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/locations/{**catch-all}"
        }
      },
      "shipping-webhooks-routes": {
        "ClusterId": "shipping-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/shipping-webhooks/{**catch-all}"
        }
      },
      "notification-routes": {
        "ClusterId": "notification-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "chat-routes": {
        "ClusterId": "notification-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "hub-routes": {
        "ClusterId": "notification-cluster",
        "Order": 1,
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "product-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "SessionAffinity": {
          "Enabled": false
        },
        "Destinations": {
          "product-1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-1": {
            "Address": "http://localhost:5007"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-1": {
            "Address": "http://localhost:5027"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-1": {
            "Address": "http://localhost:5052"
          }
        }
      },
      "seller-cluster": {
        "Destinations": {
          "seller-1": {
            "Address": "http://localhost:5042"
          }
        }
      },
      "shipping-cluster": {
        "Destinations": {
          "shipping-1": {
            "Address": "http://localhost:5070"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "shipping-1": {
            "Address": "http://localhost:5080"
          }
        }
      }
    }
  }
}

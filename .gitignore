## Base dotnet core gitignore

# Các thư mục chứa sản phẩm sau khi Build / Publish
[Bb]in/
[Oo]bj/
[Ex]bin/
[Ms]build/
[Pp]ublish/
[Pp]ublish[Oo]utput/
publish/
dist/
dist-ssr/
out/
build/
build_out.txt

# Thư mục lưu trữ các gói thư viện (Nuget, NPM) cài thêm
*.nuget.props
*.nuget.targets
packages/
node_modules/

# Các file cấu hình và cache của IDE (Visual Studio, VS Code, JetBrains Rider)
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# Lịch sử và cache của công cụ test (NUnit, Coverlet, SpecFlow...)
TestResults/
*.sequenced
*-[Cc]or[Pp]rof_*
_ReSharper*/
[Tt]est[Rr]esult*/

# File cấu hình môi trường chứa THÔNG TIN BẢO MẬT & DATABASE CONNECTION
appsettings.json
appsettings.*.json
!appsettings.Example.json
!appsettings.Template.json
*.env
*.env.*
secrets.json

# Hệ điều hành sinh ra (Windows, Mac)
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Các file Log phát sinh khi chạy ứng dụng dưới local
*.log
logs/
Log/
[Ll]og/

# Docker & Chạy local tự sinh
.dockerignore
Docs/
QueryDb/

# Data & CSV files
*.csv
**/*.csv

# Scripts
scripts/
**/scripts/
src/scripts/
*.bat
*.ps1
*.sh
seed-all.bat

# AI Assistant, AGENTS & Scratchpad Files
AGENTS.md
agents.md
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
.agents/
.antigravity/
.gemini/
.brain/
.scratch/
scratch/
**/scratch/
scratchpad.md
*.scratchpad.*
# VS Code C# Dev Tools - Auto-generated runners
.vscodecsdt/Runners/
